<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Enforces crewmate bodytype, size, and head -->
  <GeneDef>
    <defName>Gene_Crewmate_Body</defName>
    <label>crewmate body</label>
    <labelShortAdj>crewmate</labelShortAdj>
    <description>Carriers of this gene gain the body of a Crewmate. It is smaller than usual, but more metabolically efficient.</description>
    <iconPath>Crewmate/Naked_Crewmate_south</iconPath>
    <biostatCpx>1</biostatCpx>
    <biostatMet>2</biostatMet>
    <missingGeneRomanceChanceFactor>0.2</missingGeneRomanceChanceFactor>
    <forcedHeadTypes>
      <li>Crewmate_Head</li>
    </forcedHeadTypes>
    <modExtensions>
      <li Class="BigAndSmall.PawnExtension">
        <thingDefSwap>Crewmate</thingDefSwap>
        <forceThingDefSwap>true</forceThingDefSwap>
        <bodyTypes>
          <Crewmate>Male,Female</Crewmate>
          <Crewmate_Child>Child</Crewmate_Child>
        </bodyTypes>
      </li>
    </modExtensions>
  </GeneDef>

  <!-- Crewmates are extra weak to the vacuum  -->
  <GeneDef>
    <defName>VacuumWeakness</defName>
    <label>vacuum weak</label>
    <labelShortAdj>vacuum-weak</labelShortAdj>
    <description>Carriers of this gene suffer vacuum burns at a higher rate than normal.</description>
    <iconPath>UI/Icons/Genes/Gene_VacuumResistance</iconPath>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <displayOrderInCategory>20</displayOrderInCategory>
    <exclusionTags>
      <li>VacuumResistance</li>
      <li>VacuumResistance_Partial</li>
    </exclusionTags>
    <immuneToVacuumBurns>true</immuneToVacuumBurns>
    <displayCategory MayRequire="Ludeon.RimWorld.Biotech">ResistanceAndWeakness</displayCategory>
    <statOffsets>
      <VacuumResistance>-0.3</VacuumResistance>
    </statOffsets>
  </GeneDef>

  <GeneDef>
    <defName>Crewmate_Backpack</defName>
    <label>backpack</label>
    <labelShortAdj>backpacked</labelShortAdj>
    <description>Carriers of this gene develop a special backpack that offers increased carrying
      capacity and a slight increase to resiliance and coverage.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>400</displayOrderInCategory>
    <iconPath>backpack</iconPath>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <statOffsets>
      <CarryingCapacity>45</CarryingCapacity>
      <IncomingDamageFactor>-0.1</IncomingDamageFactor>
    </statOffsets>
    <renderNodeProperties>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Crewmate/Crewmate_backpack</texPath>
        <colorType>Skin</colorType>
        <parentTagDef>Body</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>90</layer>
          </defaultData>
          <dataNorth>
            <offset>(0, 0, 0)</offset>
          </dataNorth>
          <dataSouth>
            <offset>(0, 0, 0)</offset>
          </dataSouth>
          <dataEast>
            <offset>(-0.35, 0, 0)</offset>
          </dataEast>
          <dataWest>
            <offset>(0.35, 0, 0)</offset>
          </dataWest>
        </drawData>
      </li>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Crewmate/Crewmate_Visor</texPath>
        <parentTagDef>Body</parentTagDef>
        <baseLayer>70</baseLayer>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <parentTagDef>Head</parentTagDef>
      </li>
    </renderNodeProperties>
  </GeneDef>

  <!-- Increased mining stats -->
  <GeneDef>
    <defName>BetterMining</defName>
    <label>better mining</label>
    <labelShortAdj>better-mining</labelShortAdj>
    <description>Carriers of this gene are much better at ore manipulation.</description>
    <iconPath>UI/Icons/Genes/Skills\Mining\PassionAdd</iconPath>
    <displayOrderInCategory>30</displayOrderInCategory>

    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>

    <!--<passionModType>AddOneLevel</passionModType>
    doesnt seem to work -->

    <statOffsets>
      <MiningSpeed>0.20</MiningSpeed>
      <MiningYield>0.10</MiningYield>
      <DeepDrillingSpeed>0.20</DeepDrillingSpeed>
    </statOffsets>
  </GeneDef>

</Defs>