<?xml version='1.0' encoding='UTF-8'?>
<Defs>
    <AbilityDef>
        <defName>Vent</defName>
        <label>vent</label>
        <description>Skips the target a short distance away; can only target yourself.</description>
        <iconPath>UI/Impostor/Vent</iconPath>
        <writeCombatLog>True</writeCombatLog>
        <hotKey>Misc9</hotKey>
        <cooldownTicksRange>1200</cooldownTicksRange> <!-- ~30 minutes in game -->
        <stunTargetWhileCasting>True</stunTargetWhileCasting>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <statBases>
            <Ability_Duration>0</Ability_Duration>
        </statBases>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <range>20</range>
            <targetParams>
                <canTargetSelf>True</canTargetSelf>
                <canTargetPawns>False</canTargetPawns>
                <canTargetAnimals>False</canTargetAnimals>
                <canTargetItems>False</canTargetItems>
                <canTargetBuildings>False</canTargetBuildings>
            </targetParams>
            <warmupTime>1</warmupTime>
            <requireLineOfSight>false</requireLineOfSight>
        </verbProperties>
        <comps>
            <li Class="CompProperties_AbilityTeleport">
                <!-- Use custom CompAbilityEffect to enable the sound effect -->
                <compClass>CompAbilityEffect_Vent</compClass>
                <destination>Selected</destination>
                <requiresLineOfSight>false</requiresLineOfSight>
                <range>20</range>

                <clamorType>Ability</clamorType>
                <clamorRadius>10</clamorRadius>
                <destClamorType>Ability</destClamorType>
                <destClamorRadius>10</destClamorRadius>

                <sound>Impostor_Ability_Vent</sound>

                <stunTicks>18~60</stunTicks>
                <goodwillImpact>-15</goodwillImpact>
                <applyGoodwillImpactToLodgers>False</applyGoodwillImpactToLodgers>
            </li>
        </comps>
    </AbilityDef>
</Defs>