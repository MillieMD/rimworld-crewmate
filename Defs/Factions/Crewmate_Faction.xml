<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <FactionDef ParentName="FactionBase">
        <defName>Crewmate_Faction</defName>
        <label>research station</label>
        <description>TODO</description>
        <pawnSingular>crewmate</pawnSingular>
        <pawnsPlural>crewmates</pawnsPlural>
        <factionNameMaker>NamerFactionCrewmate</factionNameMaker>
        <settlementNameMaker>NamerSettlementCrewmate</settlementNameMaker>
        <leaderTitle>captain</leaderTitle>
        <leaderForceGenerateNewPawn>true</leaderForceGenerateNewPawn>
        <fixedLeaderKinds>
            <li>Crewmate_Leader</li>
        </fixedLeaderKinds>

        <settlementGenerationWeight>1</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <configurationListOrderPriority>50</configurationListOrderPriority>

        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
        <factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
        <colorSpectrum>
            <li>(0,0,0)</li>
            <li>(1,1,1)</li>
        </colorSpectrum>

        <techLevel>Spacer</techLevel>

        <xenotypeSet Inherit="False">
            <xenotypeChances>
                <Crewmate>1.0</Crewmate>
            </xenotypeChances>
        </xenotypeSet>

        <backstoryFilters>
            <li>
                <categories>
                    <li>Offworld</li>
                </categories>
            </li>
        </backstoryFilters>

        <disallowedMemes MayRequire="Ludeon.RimWorld.Ideology">
            <li>PainIsVirtue</li>
            <li>Supremacist</li>
            <li>Raider</li>
            <li>Cannibal</li>
            <li>Blindsight</li> <!-- Causes eye weirdness -->
            <li MayRequire="Ludeon.RimWorld.Anomaly">Inhuman</li>
        </disallowedMemes>

        <!-- Traders - see TraderKindDefs -->
        <baseTraderKinds>
            <li>Base_Outlander_Standard</li>
        </baseTraderKinds>
        <caravanTraderKinds>
            <li>Caravan_Outlander_BulkGoods</li>
            <li>Caravan_Outlander_Exotic</li>
        </caravanTraderKinds>
        <visitorTraderKinds>
            <li>Visitor_Outlander_Standard</li>
        </visitorTraderKinds>
        <orbitalTraderKinds>
            <li>Orbital_BulkGoods</li>
            <li>Orbital_Exotic</li>
        </orbitalTraderKinds>

        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0,35)</li>
                <li>(70, 50)</li>
                <li>(800, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <canStageAttacks>false</canStageAttacks>
        <pawnGroupMakers>
            <li>
                <kindDef>Trader</kindDef>
                <traders>
                    <Town_Trader>1</Town_Trader>
                </traders>
                <carriers>
                    <Muffalo>6</Muffalo>
                    <Dromedary>5</Dromedary>
                    <Alpaca>2</Alpaca>
                    <Elephant>1</Elephant>
                </carriers>
                <guards>
                    <Villager>3</Villager>
                    <Town_Guard>5</Town_Guard>
                </guards>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <Crewmate_Leader>1</Crewmate_Leader>
                    <Town_Guard>10</Town_Guard>
                    <Villager>10</Villager>
                </options>
            </li>
        </pawnGroupMakers>
    </FactionDef>

</Defs>