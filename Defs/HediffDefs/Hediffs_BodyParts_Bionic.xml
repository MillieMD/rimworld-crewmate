<?xml version='1.0' encoding='UTF-8'?>
<Defs>
    <HediffDef ParentName="AddedBodyPartBase">
        <defName>BionicVisor</defName>
        <label>bionic visor</label>
        <labelNoun>a bionic visor</labelNoun>
        <description>TODO: An installed bionic visor.</description>
        <descriptionHyperlinks><ThingDef>BionicVisor</ThingDef></descriptionHyperlinks>
        <spawnThingOnRemoved>BionicVisor</spawnThingOnRemoved>
        <addedPartProps>
            <solid>true</solid>
            <partEfficiency>1.25</partEfficiency>
            <betterThanNatural>true</betterThanNatural>
        </addedPartProps>
        <renderNodeProperties>
            <li Class="PawnRenderNodeProperties">
                <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
                <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
                <texPath>Things/Pawn/Wounds/BionicVisor</texPath>
                <rotDrawMode>Fresh</rotDrawMode>
                <parentTagDef>Eyes</parentTagDef>
                <drawData>
                    <defaultData>
                        <layer>100</layer>
                    </defaultData>
					<dataWest>
						<flip>true</flip>
					</dataWest>
                </drawData>
            </li>
        </renderNodeProperties>
    </HediffDef>
	
	<ThingDef ParentName="BodyPartBionicBase">
        <defName>BionicVisor</defName>
        <label>bionic visor</label>
        <description>TODO: An advanced artificial visor.</description>
        <descriptionHyperlinks><RecipeDef>InstallBionicVisor</RecipeDef></descriptionHyperlinks>
        <costList>
            <Plasteel>15</Plasteel>
            <ComponentSpacer>4</ComponentSpacer>
        </costList>
        <thingSetMakerTags>
            <li>RewardStandardMidFreq</li>
        </thingSetMakerTags>
        <statBases>
            <Mass>0.3</Mass>
        </statBases>
    </ThingDef>
	
    <RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
        <defName>InstallBionicVisor</defName>
        <label>install bionic visor</label>
        <description>Install a bionic visor.</description>
        <descriptionHyperlinks>
            <ThingDef>BionicVisor</ThingDef>
            <HediffDef>BionicVisor</HediffDef>
        </descriptionHyperlinks>
        <jobString>Installing bionic visor.</jobString>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>BionicVisor</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>BionicVisor</li>
            </thingDefs>
        </fixedIngredientFilter>
        <appliedOnFixedBodyParts>
            <li>Crewmate_Visor</li>
        </appliedOnFixedBodyParts>
        <addsHediff>BionicVisor</addsHediff>
    </RecipeDef>
</Defs>