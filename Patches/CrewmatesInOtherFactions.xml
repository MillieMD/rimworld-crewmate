<?xml version='1.0' encoding='UTF-8'?>
<!-- Add a small chance for crewmates to spawn in other factions -->
<Patch>
    <Operation Class="PatchOperationAdd" MayRequire="Ludeon.RimWorld.Royalty">
        <xpath>Defs/FactionDef[defName="Empire"]/xenotypeSet/xenotypeChances</xpath>
        <value>
            <Crewmate>0.05</Crewmate>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/FactionDef[defName="OutlanderCivil"]/xenotypeSet/xenotypeChances</xpath>
        <value>
            <Crewmate>0.05</Crewmate>
        </value>
    </Operation>
</Patch>